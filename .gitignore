# Binary/large files (submitted separately)
*.pptx

# Data backups/snapshots (not needed for source review, keep local only)
data_backup/

# Python
__pycache__/
*.pyc
.venv/

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/

# Secrets (never commit)
*.p8
*.pem
.env
# Ignore the whole directory, not just known extensions: a key saved as
# "rsa_key" or "snowflake.key" would otherwise slip past the patterns above.
keys/

# Internal recording artifacts (for producing the demo video, not for reviewers)
vf-logistics-hackathon/VOICEOVER_SCRIPT_4MIN.md
vf-logistics-hackathon/DEMO_HUONG_DAN_THAO_TAC_VI.md

# Local-only notes (not for reviewers)
vf-logistics-hackathon/_local/
